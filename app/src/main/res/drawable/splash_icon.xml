<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon for the Android 12+ SplashScreen API — same logo mark as
     ic_launcher_foreground.xml, sized 120×120dp. Per IMPLEMENTATION_PLAN.md
     Step 2. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Scale the 108dp design up to fill the 120dp canvas (scale 1.111,
         translate 6.67 each axis ≈ matching the foreground's proportions). -->
    <group android:scaleX="1.111"
           android:scaleY="1.111"
           android:translateX="-6"
           android:translateY="-6">

        <!-- Left page -->
        <path
            android:fillColor="#8b5cf6"
            android:pathData="M30,34 C38,30 46,30 53,34 L53,76 C46,72 38,72 30,76 Z" />
        <!-- Right page -->
        <path
            android:fillColor="#a78bfa"
            android:pathData="M78,34 C70,30 62,30 55,34 L55,76 C62,72 70,72 78,76 Z" />
        <!-- Spine highlight -->
        <path
            android:fillColor="#7c3aed"
            android:pathData="M53,34 L55,34 L55,76 L53,76 Z" />

        <!-- Lightning bolt overlay -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.92"
            android:pathData="M58,24 L46,50 L53,50 L49,68 L63,42 L56,42 L60,24 Z" />

    </group>
</vector>
