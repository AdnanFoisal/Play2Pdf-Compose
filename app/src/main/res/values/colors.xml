<resources>
    <!-- App-wide color tokens. These mirror the Compose BrandColors values
         (theme/Color.kt) and are only referenced by themes.xml — keeping the
         launch window the same colour as the Compose surface so there is no
         flash on cold start. Canonical brand: green #1DB954 (docs/BRAND.md). -->

    <!-- Brand -->
    <color name="brand">#1DB954</color>
    <color name="brand_dark">#12873B</color>
    <color name="brand_light">#1ED760</color>

    <!-- Surface palette (dark, green-tinted) -->
    <color name="surface0">#080C0A</color>
    <color name="surface1">#121B15</color>
    <color name="surface2">#18241C</color>
    <color name="surface3">#0E1611</color>
    <color name="surface_text">#FFFFFF</color>
    <color name="surface_text_muted">#A1A1AA</color>
    <color name="surface_border">#0FFFFFFF</color>

    <!-- Status -->
    <color name="success">#1DB954</color>
    <color name="error">#EF4444</color>
    <color name="warning">#FBBF24</color>
</resources>
